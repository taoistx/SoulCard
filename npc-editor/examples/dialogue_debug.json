  "nodes": {
    "root": {
      "title": "路边偶遇露西",
      "body": "你又见到她，似乎依然没有离开。",
      "optionList": "mainChoices"
    },
    "unwell": {
      "title": "露西的回答",
      "body": "她摇摇头，似乎很难受。",
      "optionList": "unwellChoices"
    },
    "textNode1": {
      "body": "她非常失望，但又不愿意表现出来。",
      "optionList": "mainChoices"
    },
    "silent": {
      "title": "沉默",
      "body": "她没有回答。",
      "optionList": "silentChoices"
    },
    "monster": {
      "title": "异变",
      "body": "她变成了怪兽。",
      "effects": [
        {
          "type": "setFlag",
          "key": "debugLucyMonster",
          "value": true
        }
      ],
      "optionList": "monsterChoices"
    },
    "debug_state": {
      "title": "调整测试状态",
      "body": "选择一项后返回开场，观察“你好点吗？”是否出现。\n\n理解感染 / !（吃药 & 已经康复）\n只有不理解感染、且吃药和已经康复都为真时，才隐藏该选项。\n\n“没有吃药”是独立 Flag，可用来试写其他条件。",
      "optionList": "debug_stateChoices"
    }
  },
