{
  "schemaVersion": 1,
  "id": "thomas",
  "name": "幸存者 托马斯",
  "start": {
    "default": "root",
    "rules": [
      {
        "when": {
          "mode": "all",
          "clauses": [
            {
              "source": "flag",
              "key": "thomasWound",
              "operator": "eq",
              "value": "treated"
            }
          ]
        },
        "node": "root"
      },
      {
        "when": {
          "mode": "all",
          "clauses": [
            {
              "source": "flag",
              "key": "thomasInfected",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "node": "infected"
      }
    ]
  },
  "nodes": {
    "root": {
      "body": {
        "default": "她扶着完整的堤边，终于喘匀了气。“再往后一步就是断口……谢谢。”她看看岸台的火，又望向高处。“我不想一个人留在这儿。营地需要人做事吗？你要上山，我也得先收拾一下。”",
        "variants": [
          {
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "source": "flag",
                  "key": "thomasResentful",
                  "operator": "eq",
                  "value": true
                }
              ]
            },
            "text": "她记得自己逃出险地时你没有出手。“我能走，不代表我忘了那一次。”"
          },
          {
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "source": "flag",
                  "key": "thomasWound",
                  "operator": "eq",
                  "value": "treated"
                }
              ]
            },
            "text": "包扎压住了伤口。她试着站稳：“这次能自己走了。告诉我哪条路可走。”"
          },
          {
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "source": "flag",
                  "key": "thomasPrepared",
                  "operator": "eq",
                  "value": true
                }
              ]
            },
            "text": "她把实物和你说过的路况反复核对。“不是因为不怕，我只是准备了能用的东西。”"
          },
          {
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "source": "flag",
                  "key": "thomasTravelled",
                  "operator": "eq",
                  "value": true
                }
              ]
            },
            "text": "“贴到铁壁后，我一路沿有脚印的硬处走。”她把行囊靠在身旁。“营地、棚子、台子……总得找个我能待下去的地方。”"
          }
        ]
      },
      "options": [
        {
          "id": "camp",
          "label": "告诉她岸台营地的打捞活计",
          "hint": "决定去向；下一次长休后按行程移动",
          "action": "v06_thomas_camp",
          "next": "departure"
        },
        {
          "id": "climb",
          "label": "告诉她自己要上山",
          "hint": "决定去向；下一次长休后按行程移动",
          "action": "v06_thomas_climb",
          "next": "departure"
        },
        {
          "id": "stop",
          "label": "建议她在山腰检修台停留",
          "hint": "决定去向；下一次长休后按行程移动",
          "action": "v06_thomas_stop",
          "next": "departure"
        },
        {
          "id": "route",
          "label": "分享实际验证过的走法",
          "hint": "亲见狭道落脚处，或清开检修槽",
          "action": "v06_thomas_route",
          "next": "root"
        },
        {
          "id": "bandage",
          "label": "用韧膜包扎她的伤口",
          "hint": "韧膜 -1；治疗与准备分别记录",
          "action": "v06_thomas_bandage",
          "next": "root"
        },
        {
          "id": "supply",
          "label": "给她留包扎材料",
          "hint": "韧膜 -1；准备成立，尚未治疗",
          "action": "v06_thomas_supply",
          "next": "root"
        },
        {
          "id": "protection",
          "label": "交给她一套实际防护",
          "hint": "移交防护；若正在穿戴会卸下",
          "action": "v06_thomas_protection",
          "next": "root"
        },
        {
          "id": "ask",
          "label": "问她还能否撑住",
          "hint": "",
          "next": "infected"
        }
      ]
    },
    "infected": {
      "body": "她按着甲缝：“先别让我一个人待着。”孢子造成的伤害还在，鼓励不能代替包扎。",
      "options": [
        {
          "id": "back",
          "label": "返回",
          "hint": "",
          "next": "root"
        }
      ]
    },
    "departure": {
      "body": "她把散开的行囊重新扎紧。“我记住了。先把东西收好，再沿堤走。要是到得早，我会留点痕迹。”",
      "options": [
        {
          "id": "back",
          "label": "再说几句",
          "next": "root"
        }
      ]
    }
  }
}
