  "nodes": {
    "root": {
      "kicker": "NPC · 岸台营地",
      "title": "渔夫 艾迪",
      "body": {
        "default": "艾迪把一只湿壳翻过来晾着，抬眼看你。\n“从浅滩上来的？先站稳，台子外面都是软泥。”",
        "variants": [
          {
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "source": "flag",
                  "key": "eddieMet",
                  "operator": "eq",
                  "value": true
                }
              ]
            },
            "text": "“我这有好东西你可能用得着。”\n“拿新鲜的肉换装备，好膜能制防护，也能罩住作业位。想换什么，到货摊上看看。”"
          }
        ]
      },
      "effects": [
        {
          "type": "setFlag",
          "key": "eddieMet",
          "value": true
        }
      ],
      "options": [
        {
          "id": "ask_place",
          "label": "这里是什么地方？",
          "hint": "免费情报",
          "next": "church_info"
        },
        {
          "id": "attack",
          "label": {
            "default": "袭击艾迪，夺走货物",
            "variants": []
          },
          "hint": "触发战斗",
          "action": "fight_eddie"
        },
        {
          "id": "shop",
          "label": "看看你的货物",
          "hint": "打开商店 · 以物易物",
          "action": "shop_eddie"
        },
        {
          "id": "slice_salvage",
          "label": "问漂积湾里有什么",
          "hint": "",
          "action": "v06_eddie_salvage",
          "next": "slice_salvage"
        },
        {
          "id": "slice_report",
          "label": "告诉他亲自试穿的结果",
          "hint": "",
          "next": "slice_report"
        }
      ]
    },
    "church_info": {
      "kicker": "艾迪 · 情报",
      "title": "山上的教堂仍有人往来",
      "body": "“看见铁壁上头那个尖顶了吗？那是教堂。我见过有人背着东西从那边下来，石阶也有人修。至于能不能回到原来的地方……我没见谁回来告诉我。”\n他朝硬堤指了指：“沿堤上去，贴到铁壁再往高处走。”",
      "options": [
        {
          "id": "ask_identity",
          "label": "你是谁？",
          "hint": "情报",
          "next": "eddie_info"
        },
        {
          "id": "ask_flesh",
          "label": "吃人的血肉？！",
          "hint": "情报",
          "next": "flesh_info"
        },
        {
          "id": "back_trade",
          "label": "返回",
          "hint": "返回",
          "next": "root"
        }
      ],
      "effects": []
    },
    "eddie_info": {
      "kicker": "艾迪 · 情报",
      "title": "这里能交易",
      "body": "“我叫艾迪。水把东西送过来，我挑能用的，拿去换肉。你有新鲜的肉也能换东西，废壳里的好膜我也用得上。”",
      "options": [
        {
          "id": "ask_stay",
          "label": "你为什么不去那建筑？",
          "hint": "情报",
          "next": "whyhere_info"
        },
        {
          "id": "back_trade",
          "label": "继续交易",
          "hint": "打开商店",
          "action": "shop_eddie"
        }
      ],
      "effects": []
    },
    "flesh_info": {
      "kicker": "艾迪 · 情报",
      "title": "血肉只能填补伤势",
      "body": "“能吃的肉会让伤口合上，别拿长白丝的凑数。可你甲缝里那东西已经扎进去了，吃肉拔不出来。”",
      "options": [
        {
          "id": "back_trade",
          "label": "返回",
          "hint": "返回",
          "next": "root"
        }
      ],
      "effects": []
    },
    "whyhere_info": {
      "kicker": "艾迪 · 情报",
      "title": "这里能交易",
      "body": "“山腰的灰粉，我受不了。下来的那些人也从不肯带我走。这里还有活计，我就先守着。”",
      "options": [
        {
          "id": "back_trade",
          "label": "返回",
          "hint": "返回",
          "next": "root"
        }
      ],
      "effects": []
    },
    "slice_salvage": {
      "body": "“台子左边的回水湾，会把东西留在石头旁。废壳下面有时夹着好膜，剥掉沾泥的外层，剩下的能包甲缝。”",
      "options": [
        {
          "id": "back",
          "label": "返回",
          "hint": "",
          "next": "root"
        }
      ]
    },
    "slice_report": {
      "body": {
        "default": "你还没有亲自穿着仿罩走过菌丛，暂时没有验证可说。",
        "variants": [
          {
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "source": "flag",
                  "key": "wrapTested",
                  "operator": "eq",
                  "value": true
                }
              ]
            },
            "text": "你说出穿过菌丛时甲缝没有再刺痛的体验。艾迪翻过罩布：“能挡这一段，不代表能挡刀。”"
          }
        ]
      },
      "options": [
        {
          "id": "back",
          "label": "返回",
          "hint": "",
          "next": "root"
        }
      ]
    }
